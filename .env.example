NEXT_PUBLIC_ADMIN_EMAIL=lukas.enginer7@gmail.com

# Somente configuração do app Web. Nunca inclua senha, chave privada ou conta de serviço.
# Configure estes valores no Firebase Console > Configurações do projeto > Seus apps.
# apiKey
NEXT_PUBLIC_FIREBASE_API_KEY=
# authDomain (sem https://)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# projectId
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# storageBucket (nome exato do Console, sem gs://)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# messagingSenderId
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# appId (não é measurementId)
NEXT_PUBLIC_FIREBASE_APP_ID=
